{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot.schema.json",
  "title": "Shot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scene_id",
    "ordinal",
    "start_state",
    "end_state",
    "character_ids",
    "screen_positions",
    "eyelines",
    "framing",
    "camera_motion",
    "action",
    "dialogue",
    "audio_continuity",
    "duration_requested_s",
    "seed",
    "reference_asset_ids",
    "observed_settings",
    "dependencies",
    "approval_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "scene_id": {
      "type": "string"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "start_state": {
      "type": "string"
    },
    "end_state": {
      "type": "string"
    },
    "character_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "screen_positions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "left",
          "right",
          "center",
          "offscreen"
        ]
      }
    },
    "eyelines": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "left",
          "right",
          "camera",
          "down",
          "offscreen_left",
          "offscreen_right"
        ]
      }
    },
    "framing": {
      "type": "string"
    },
    "camera_motion": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "text",
          "tone"
        ],
        "properties": {
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "type": "string"
          },
          "pause_after": {
            "type": "string"
          }
        }
      }
    },
    "audio_continuity": {
      "type": "string"
    },
    "duration_requested_s": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prop_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "holder",
          "count_visible"
        ],
        "properties": {
          "holder": {
            "type": "string"
          },
          "count_visible": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "observed_settings": {
      "type": "object",
      "description": "Only values actually observed in the provider UI. Unknown => null.",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "prompt_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}